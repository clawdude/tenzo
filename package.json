{
  "name": "tenzo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "tenzo": "node apps/daemon/src/cli.ts",
    "parity": "node tools/parity/src/parity.ts",
    "smoke": "pnpm --filter @tenzo/web build && node tools/smoke/src/smoke.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
